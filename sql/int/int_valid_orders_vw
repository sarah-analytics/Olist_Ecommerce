/* =========================================================
   INT VIEW — Valid Orders

   Grain        : 1 row per order_id
   Description  : Canonical set of completed (delivered) orders
                  enriched with customer_unique_id

   Purpose      :
   - Single Source of Truth (SSOT) for all KPI calculations
   - Ensures consistent filtering and customer identity mapping
   - Eliminates repeated joins between orders and customers

   Source       :
   - orders
   - customers

   Filters      :
   - order_status = 'delivered'

   Output Columns
   --------------
   order_id
   customer_id
   customer_unique_id
   order_ts

   Notes
   -----
   - order_ts renamed from order_purchase_timestamp for consistency
   - customer_unique_id is stable identity across multiple customer_id
   - This view must be used as the base for retention, revenue, and cohort KPIs

   ========================================================= */

CREATE OR REPLACE VIEW int_valid_orders_vw AS

SELECT
    o.order_id,

    o.customer_id,

    c.customer_unique_id,

    o.order_purchase_timestamp AS order_ts

FROM orders AS o

JOIN customers AS c
  ON c.customer_id = o.customer_id

WHERE o.order_status = 'delivered';
